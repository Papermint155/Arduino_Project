#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>

// Pin Definitions matching your diagram
#define DHTPIN 2       // DHT11 Data pin connected to Digital Pin 2
#define DHTTYPE DHT11  // Blue sensor is DHT11
#define RELAY_PIN 3    // Relay IN pin connected to Digital Pin 3
#define BUZZER_PIN 8   // Built-in buzzer on Cytron Maker UNO

// Temperature threshold in Celsius to turn the fan ON
const float TEMP_THRESHOLD = 28.0; 

DHT dht(DHTPIN, DHTTYPE);

// Most I2C LCDs use address 0x27 (if screen stays blank, try 0x3F)
LiquidCrystal_I2C lcd(0x27, 16, 2);

bool fanState = false;

void setup() {
  Serial.begin(9600);
  
  pinMode(RELAY_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW); // Start with fan OFF

  dht.begin();
  
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Smart Fan System");
  lcd.setCursor(0, 1);
  lcd.print("Starting up...");
  delay(2000);
  lcd.clear();
}

void loop() {
  delay(2000); // DHT11 reads every 2 seconds

  float h = dht.readHumidity();
  float t = dht.readTemperature(); // Reads in Celsius

  // Check if sensor reading failed
  if (isnan(h) || isnan(t)) {
    lcd.setCursor(0, 0);
    lcd.print("Sensor Error!   ");
    lcd.setCursor(0, 1);
    lcd.print("Check DHT11 wire");
    return;
  }

  // Row 1: Display Temperature & Humidity
  lcd.setCursor(0, 0);
  lcd.print("T:");
  lcd.print(t, 1);
  lcd.print((char)223); // Degree symbol
  lcd.print("C H:");
  lcd.print((int)h);
  lcd.print("%  ");

  // Row 2: Control Fan Relay based on Temperature
  lcd.setCursor(0, 1);
  if (t >= TEMP_THRESHOLD) {
    digitalWrite(RELAY_PIN, HIGH); // Turn Relay ON (change to LOW if active-low relay)
    lcd.print("Fan: ON  (Hot!) ");
    
    // Short beep on Maker UNO buzzer when fan first kicks on
    if (!fanState) {
      tone(BUZZER_PIN, 1500, 150);
      fanState = true;
    }
  } else {
    digitalWrite(RELAY_PIN, LOW);  // Turn Relay OFF
    lcd.print("Fan: OFF (Cool) ");
    fanState = false;
  }
}
